PORT=5000
# Comma-separated; * wildcard allowed (e.g. preview deploys): https://app.vercel.app,https://app-*.vercel.app
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_tracker
# Hosted MySQL usually needs TLS. DB_SSL_CA: provider CA cert (PEM; \n-escaped is fine) if not publicly signed.
DB_SSL=false
DB_SSL_CA=

# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
